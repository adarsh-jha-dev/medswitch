# Postgres connection string (Neon or Supabase). Enable the `vector` extension
# on this database before running migrations — Day 3 needs pgvector and it's
# painless to turn on now vs. later.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# From Bright Data account settings, after redeeming the `wemakedevs` promo
# code under billing -> promo code.
BRIGHTDATA_API_TOKEN=""

# Kolkata pincode held constant across all Day 1 scraping so prices/stock are
# comparable across retailers.
SCRAPE_PINCODE="700001"

# Pinned collector IDs (see CLAUDE.md) — reuse these rather than recreating.
PHARMEASY_PRODUCT_COLLECTOR="c_msx1mjrr2i7eyw2x5z"
PHARMEASY_DISCOVERY_COLLECTOR="c_msx1nb0i2pk3c7ydje"
JANAUSHADHI_COLLECTOR="c_msx1nhwk2akso0fxfx"

# Day 2: LLM fallback parser for Jan Aushadhi's free-text composition strings
# (src/parse/llm.ts) — PharmEasy's rigid grammar never needs this.
OPENAI_API_KEY=""
# Override if the default model isn't on your account.
# OPENAI_MODEL="gpt-4o-mini"
